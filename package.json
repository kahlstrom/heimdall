{
  "name": "@kahlstrom/heimdall",
  "version": "0.2.0",
  "description": "Shared quality gate that coding agents and developers run before calling work done",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kahlstrom/heimdall"
  },
  "keywords": [
    "quality-gate",
    "lint",
    "ci",
    "eslint",
    "vitest",
    "knip",
    "jscpd",
    "ai-agents"
  ],
  "type": "module",
  "bin": {
    "heimdall": "./dist/cli.js"
  },
  "files": [
    "dist",
    "configs/README.md",
    "configs/example",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "knip": "knip --reporter json --no-progress --production",
    "jscpd": "jscpd src --reporters json --silent"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "9.39.5",
    "jscpd": "4.3.0",
    "knip": "5.88.1",
    "typescript-eslint": "^8.17.0",
    "vitest": "2.1.9"
  }
}
