{
  "requireParentBase": false,
  "maxChangedFiles": 100,
  "steps": {
    "typecheck": {
      "enabled": true,
      "command": "npx --no-install tsc --noEmit",
      "timeoutMs": 300000
    },
    "tests": {
      "enabled": true,
      "command": "npx --no-install vitest run --reporter=json --reporter=verbose",
      "timeoutMs": 300000
    },
    "eslint": {
      "enabled": true,
      "command": "npx --no-install eslint . -f json",
      "timeoutMs": 300000,
      "maxWarnings": 0
    },
    "knip": {
      "enabled": true,
      "command": "\"$HEIMDALL_CONFIG_DIR/../node_modules/.bin/knip\" --config \"$HEIMDALL_CONFIG_DIR/knip.json\" --reporter json --no-progress",
      "timeoutMs": 300000
    },
    "jscpd": {
      "enabled": true,
      "command": "\"$HEIMDALL_CONFIG_DIR/../node_modules/.bin/jscpd\" src --reporters json --silent --output \"$HEIMDALL_TMP\" && cat \"$HEIMDALL_TMP/jscpd-report.json\"",
      "timeoutMs": 300000
    },
    "secrets": {
      "enabled": false,
      "command": "npx --no-install -p secretlint@14 secretlint --secretlintrc \"$HEIMDALL_CONFIG_DIR/.secretlintrc.json\" --format json \"**/*\"",
      "timeoutMs": 300000
    },
    "architecture": {
      "enabled": false,
      "command": "npx --no-install -p dependency-cruiser@18 depcruise --config \"$HEIMDALL_CONFIG_DIR/.dependency-cruiser.cjs\" src --output-type json",
      "timeoutMs": 300000
    },
    "line-checks": {
      "enabled": true,
      "allowSilencing": []
    }
  },
  "flakes": [],
  "setup": [],
  "teardown": [],
  "protectedPaths": []
}
